{
  "version": "1.4.0-yisheng-history-4cell",
  "source": "E:\\SC Sc.ini [DOCTOR] + DoctBrw.Set + CC.DAT (clinic sample)",
  "layout": "yisheng-doctor-3pane-v1",
  "layoutGrid": {
    "columns": 12,
    "rows": 12,
    "components": [
      { "id": "queue-panel", "type": "QueuePanel", "grid": { "x": 0, "y": 0, "w": 2, "h": 12 }, "visible": true, "title": "掛號清單" },
      { "id": "allergy-banner", "type": "AllergyBanner", "grid": { "x": 2, "y": 0, "w": 7, "h": 1 }, "visible": true, "title": "過敏警示帶" },
      { "id": "patient-header", "type": "PatientHeader", "grid": { "x": 2, "y": 1, "w": 7, "h": 1 }, "visible": true, "title": "病患標題列" },
      { "id": "lesion-photos", "type": "LesionPhotos", "grid": { "x": 2, "y": 2, "w": 7, "h": 3 }, "visible": true, "title": "病灶照片區" },
      { "id": "chief-complaint", "type": "ChiefComplaint", "grid": { "x": 2, "y": 5, "w": 7, "h": 2 }, "visible": true, "title": "主訴 CC" },
      { "id": "diagnoses", "type": "Diagnoses", "grid": { "x": 2, "y": 7, "w": 7, "h": 2 }, "visible": true, "title": "診斷病名" },
      { "id": "current-rx", "type": "CurrentRx", "grid": { "x": 2, "y": 9, "w": 7, "h": 3 }, "visible": true, "title": "處方開立" },
      { "id": "right-panel", "type": "RightPanel", "grid": { "x": 9, "y": 0, "w": 3, "h": 12 }, "visible": true, "title": "快捷與歷史" }
    ]
  },
  "sections": {
    "allergyBanner": {
      "sticky": true,
      "enabled": true
    },
    "lesionPhotos": {
      "heightRatio": 0.28,
      "minHeightPx": 160,
      "enabled": false
    },
    "commandLine": {
      "enabled": true,
      "autoFocus": true
    },
    "rightPanel": {
      "mode": "history",
      "defaultExpanded": true,
      "widthPx": 320
    },
    "queuePanel": {
      "mode": "table",
      "fontSizePx": 14
    },
    "prevRxAboveCurrent": false,
    "rightRailCollapsedByDefault": false
  },
  "doctorPreferences": {
    "rightPanelMode": "history",
    "entryFocus": "command",
    "drugDisplayMode": "customName",
    "historyFontSizePx": 14,
    "historyRxColWidthCh": 40,
    "useBigRxPalette": false,
    "newHistoryPanel": true,
    "dittoCc": true,
    "dittoDx": true,
    "dittoRxSkipDuplicate": true,
    "dittoCcStampVisitDate": true,
    "hideHistoryIcd": false,
    "showHistoryRxVisitDate": true,
    "allergyEmptyText": "無",
    "rxSearchOrder": "customName",
    "dxSearchOrder": "diagnosisName",
    "enableQuickPriceF2": false
  },
